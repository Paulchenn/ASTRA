% % Zeile 2  (y = −3.55)
% \draw[cline, color=clrCurve]
%   (0.00,-3.55) -- (0.55,-3.55);
% \node[font=\small, anchor=west] at (0.70,-3.55) {Konst.\,Kurve};

% \draw[cline, color=clrCurveAccel]
%   (3.40,-3.55) -- (3.95,-3.55);
% \node[font=\small, anchor=west] at (4.10,-3.55) {Beschl.\,Kurve};

% \draw[cline, color=clrCurveBrake]
%   (6.50,-3.55) -- (7.05,-3.55);
% \node[font=\small, anchor=west] at (7.20,-3.55) {Gebr.\,Kurve};

\end{tikzpicture}
% \end{document}